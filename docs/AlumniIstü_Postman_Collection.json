    {
      "name": "5. Authentication, Registration & CAPTCHA",
      "item": [
        {
          "name": "5.1 GET CAPTCHA Challenge (/api/v1/auth/captcha)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.captcha_id) {",
                  "  pm.collectionVariables.set('captcha_id', json.data.captcha_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/captcha?mode=alphanumeric",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "captcha"],
              "query": [
                { "key": "mode", "value": "alphanumeric", "description": "alphanumeric or math" }
              ]
            },
            "description": "Generates a local SVG CAPTCHA challenge (stores hashed answer server-side with 300s TTL) and saves captcha_id to collection variables. Open image_data_uri or svg to read the challenge."
          }
        },
        {
          "name": "5.2 POST Register - Missing CAPTCHA (Expects 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"bot.attempt\",\n  \"email\": \"bot.attempt@ogr.iu.edu.tr\",\n  \"password\": \"SecurePass2026!\",\n  \"password_confirmation\": \"SecurePass2026!\",\n  \"full_name\": \"Automated Bot\",\n  \"role\": \"alumni\",\n  \"graduation_year\": 2024\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Verifies that registration without captcha_id and captcha_answer is rejected with HTTP 422 (CAPTCHA_MISSING) before creating any user."
          }
        },
        {
          "name": "5.3 POST Register - Invalid CAPTCHA Answer (Expects 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"zeynep.yilmaz\",\n  \"email\": \"zeynep.yilmaz@ogr.iu.edu.tr\",\n  \"password\": \"SecurePass2026!\",\n  \"password_confirmation\": \"SecurePass2026!\",\n  \"full_name\": \"Zeynep Yılmaz\",\n  \"role\": \"alumni\",\n  \"graduation_year\": 2024,\n  \"department_id\": 1,\n  \"captcha_id\": \"{{captcha_id}}\",\n  \"captcha_answer\": \"WRONG99\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Verifies that an incorrect CAPTCHA answer returns HTTP 422 (CAPTCHA_INCORRECT) and does not create the user."
          }
        },
        {
          "name": "5.4 POST Register - Valid Account with Solved CAPTCHA (Expects 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"zeynep.yilmaz\",\n  \"email\": \"zeynep.yilmaz@ogr.iu.edu.tr\",\n  \"password\": \"SecurePass2026!\",\n  \"password_confirmation\": \"SecurePass2026!\",\n  \"full_name\": \"Zeynep Yılmaz\",\n  \"role\": \"alumni\",\n  \"graduation_year\": 2024,\n  \"department_id\": 1,\n  \"company\": \"Trendyol Group\",\n  \"job_title\": \"Product Analyst\",\n  \"captcha_id\": \"{{captcha_id}}\",\n  \"captcha_answer\": \"REPLACE_WITH_CAPTCHA_ANSWER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "First run 5.1 GET CAPTCHA Challenge, read the SVG answer, replace REPLACE_WITH_CAPTCHA_ANSWER, and send. Returns 201 Created with sanitized user + Bearer access_token. Re-sending with the same captcha_id triggers 422 CAPTCHA_REUSED."
          }
        },
        {
          "name": "5.5 POST Login - Authenticate & Receive Access Token (/api/auth/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"emre.arslan\",\n  \"password\": \"AlumniPass2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates seeded or newly registered username/email + password and saves the HS256 Bearer access_token."
          }
        },
        {
          "name": "5.6 POST Login - Invalid Password (Expects 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"emre.arslan\",\n  \"password\": \"WrongPassword99!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Verifies wrong password returns HTTP 401 INVALID_CREDENTIALS."
          }
        },
        {
          "name": "5.7 GET Current User Profile - Protected with Bearer Token (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Sends req + Bearer token and receives authenticated user profile, role, and RBAC permissions."
          }
        },
        {
          "name": "5.8 POST Logout - Revoke Current Access Token (/api/auth/logout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes the current Bearer token server-side (HTTP 200). Re-running 5.7 GET /api/auth/me with the same token will now return HTTP 401 TOKEN_REVOKED."
          }
        },
        {
          "name": "5.9 GET Current User Profile - After Logout / Revoked Token (Expects 401)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Run immediately after 5.8 Logout to confirm the revoked token is rejected with HTTP 401 TOKEN_REVOKED."
          }
        },
        {
          "name": "5.10 GET Current User Profile - Missing Token (Expects 401)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Verifies unauthenticated guest access to a protected route returns HTTP 401 TOKEN_MISSING."
          }
        }
      ]
    },
    {
      "name": "6. Google OAuth 2.0 Registration & Sign-In",
      "item": [
        {
          "name": "6.1 GET Auth Providers Readiness (/api/v1/auth/providers)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/providers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "providers"]
            },
            "description": "Checks whether GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET are configured and returns CAPTCHA & public role metadata."
          }
        },
        {
          "name": "6.2 GET Initiate Google OAuth URL (/api/v1/auth/google?format=json)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google?role=alumni&format=json",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google"],
              "query": [
                { "key": "role", "value": "alumni" },
                { "key": "format", "value": "json" }
              ]
            },
            "description": "Returns the Google OAuth 2.0 authorize_url and HMAC-signed CSRF state (or 503 GOOGLE_OAUTH_NOT_CONFIGURED if .env keys are empty)."
          }
        },
        {
          "name": "6.3 GET Google Callback - Cancelled Consent (Expects 400)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/callback?error=access_denied",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google", "callback"],
              "query": [
                { "key": "error", "value": "access_denied" }
              ]
            },
            "description": "Verifies graceful handling when the user cancels Google OAuth consent (returns 400 OAUTH_CONSENT_CANCELLED)."
          }
        },
        {
