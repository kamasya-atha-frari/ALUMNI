{
  "openapi": "3.1.0",
  "info": {
    "title": "AlumniNexus API",
    "description": "Next-Gen Alumni Intelligence & Career Trajectory Engine for Istanbul University Management Information Systems (YBS). Full CRUD enabled with database persistence, job board, applications pipeline, and in-memory endpoints.",
    "version": "1.3.0",
    "contact": {
      "name": "AlumniNexus Core Engineering",
      "email": "nexus-mis@ogr.iu.edu.tr"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Docker Containerized Apache Environment"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "System health probe & telemetry"
    },
    {
      "name": "Users (Week 03 Milestone)",
      "description": "In-memory User CRUD endpoints without database"
    },
    {
      "name": "Alumni V1",
      "description": "Alumni database directory queries"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health Probe (Whiteboard Item 1)",
        "description": "Returns system telemetry and health status in JSON format.",
        "responses": {
          "200": {
            "description": "JSON health status",
            "content": {
              "application/json": {
                "example": {
                  "status": "healthy",
                  "service": "AlumniNexus API Core",
                  "version": "1.3.0",
                  "timestamp": "2026-10-13T01:30:00+03:00"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users (Week 03 Milestone)"],
        "summary": "List All Users (Whiteboard Item 4)",
        "description": "Returns an array of all user records currently stored in-memory.",
        "responses": {
          "200": {
            "description": "List of all users",
            "content": {
              "application/json": {
                "example": [
                  { "id": 1, "name": "Elif Kaya", "graduationYear": 2024 },
                  { "id": 2, "name": "Mert Aydın", "graduationYear": 2021 },
                  { "id": 3, "name": "Zeynep Arslan", "graduationYear": 2019 },
                  { "id": 4, "name": "Can Öztürk", "graduationYear": 2023 }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users (Week 03 Milestone)"],
        "summary": "Create User (Whiteboard Item 3)",
        "description": "Adds a new user in-memory (no database yet). Assigns an ID and responds with HTTP 201 Created.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "example": "Elif Kaya" },
                  "graduationYear": { "type": "integer", "example": 2024 }
                }
              },
              "example": {
                "name": "Elif Kaya",
                "graduationYear": 2024
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "example": {
                  "id": 42,
                  "name": "Elif Kaya",
                  "graduationYear": 2024
                }
              }
            }
          },
          "400": {
            "description": "Validation error (e.g. missing name)"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["Users (Week 03 Milestone)"],
        "summary": "Get User by ID (Whiteboard Item 5)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "User profile found",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "name": "Elif Kaya",
                  "graduationYear": 2024
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "tags": ["Users (Week 03 Milestone)"],
        "summary": "Full Replacement of User (Whiteboard Item 5)",
        "description": "Replaces the whole user record for the given ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "Elif Kaya Akın",
                "graduationYear": 2025
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User fully replaced"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "patch": {
        "tags": ["Users (Week 03 Milestone)"],
        "summary": "Partial Update of User (Whiteboard Item 5)",
        "description": "Updates specific fields of the user record (e.g. graduationYear only).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "graduationYear": 2025
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User partially updated"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "delete": {
        "tags": ["Users (Week 03 Milestone)"],
        "summary": "Delete User (Whiteboard Item 6)",
        "description": "Removes the user with the given ID from memory.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully removed"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/swagger": {
      "get": {
        "tags": ["Health"],
        "summary": "Swagger Documentation Viewer (Whiteboard Item 7)",
        "description": "Serves interactive Swagger UI HTML explorer or raw OpenAPI JSON specification.",
        "responses": {
          "200": {
            "description": "Swagger UI HTML page or OpenAPI JSON spec"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "System Telemetry & Health Probe",
        "responses": {
          "200": { "description": "Healthy telemetry response" }
        }
      }
    },
    "/api/v1/alumni": {
      "get": {
        "tags": ["Alumni V1"],
        "summary": "Parametric Alumni Directory Query (READ All)",
        "parameters": [
          { "name": "cohort", "in": "query", "description": "Graduation cohort filter (e.g., 2023)", "schema": { "type": "integer" } },
          { "name": "industry", "in": "query", "description": "Filter by industry sector", "schema": { "type": "string" } },
          { "name": "mentor", "in": "query", "description": "Filter by active mentor flag (true/false)", "schema": { "type": "boolean" } },
          { "name": "search", "in": "query", "description": "Search keyword in name, company, or role", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of matched alumni profiles" }
        }
      },
      "post": {
        "summary": "Create Alumni Profile (CREATE)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["full_name", "email"],
                "properties": {
                  "full_name": { "type": "string", "example": "Ada Lovelace" },
                  "email": { "type": "string", "example": "ada@cv.edu.tr" },
                  "student_id": { "type": "string", "example": "130240099" },
                  "cohort": { "type": "integer", "example": 2024 },
                  "company": { "type": "string", "example": "DeepMind" },
                  "role": { "type": "string", "example": "AI Systems Engineer" },
                  "industry": { "type": "string", "example": "Artificial Intelligence" },
                  "location": { "type": "string", "example": "London, UK" },
                  "skills": { "type": "array", "items": { "type": "string" }, "example": ["Python", "Algorithms", "C++"] },
                  "is_mentor": { "type": "boolean", "example": true },
                  "mentor_capacity": { "type": "integer", "example": 3 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Alumni profile created successfully" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/alumni/{id}": {
      "get": {
        "tags": ["Alumni V1"],
        "summary": "Detailed Alumni Profile by ID (READ Single)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Profile detail object" },
          "404": { "description": "Profile not found" }
        }
      },
      "put": {
        "summary": "Update Alumni Profile (UPDATE)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "full_name": { "type": "string" },
                  "email": { "type": "string" },
                  "company": { "type": "string" },
                  "role": { "type": "string" },
                  "industry": { "type": "string" },
                  "skills": { "type": "array", "items": { "type": "string" } },
                  "is_mentor": { "type": "boolean" },
                  "mentor_capacity": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" },
          "404": { "description": "Profile not found" }
        }
      },
      "delete": {
        "summary": "Delete Alumni Profile (DELETE)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Profile deleted successfully" },
          "404": { "description": "Profile not found" }
        }
      }
    },
    "/api/v1/analytics": {
      "get": {
        "tags": ["Alumni V1"],
        "summary": "Career Mobility & Accreditation Analytics",
        "responses": {
          "200": { "description": "Institutional employment rate and industry KPIs" }
        }
      }
    },
    "/api/v1/job-postings": {
      "get": {
        "summary": "List Job Postings (READ All)",
        "parameters": [
          { "name": "job_type", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of active job postings" }
        }
      },
      "post": {
        "summary": "Create Job Posting (CREATE)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "description"],
                "properties": {
                  "title": { "type": "string" },
                  "company_name": { "type": "string" },
                  "description": { "type": "string" },
                  "location": { "type": "string" },
                  "job_type": { "type": "string", "enum": ["full-time", "remote", "internship", "contract"] },
                  "salary_range": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Job posting published successfully" }
        }
      }
    },
    "/api/v1/job-postings/{id}": {
      "get": {
        "summary": "Get Single Job Posting (READ Single)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Job posting detail" } }
      },
      "put": {
        "summary": "Update Job Posting (UPDATE)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Job posting updated" } }
      },
      "delete": {
        "summary": "Delete Job Posting (DELETE)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Job posting deleted" } }
      }
    },
    "/api/v1/companies/{id}/job-postings": {
      "get": {
        "summary": "Get Job Postings for Company (Nested Route)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Job postings published by company" } }
      }
    },
    "/api/v1/applications": {
      "get": {
        "summary": "List Applications (READ All)",
        "parameters": [
          { "name": "job_posting_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "List of candidate applications" } }
      },
      "post": {
        "summary": "Submit Application (CREATE)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["job_posting_id", "applicant_name", "applicant_email"],
                "properties": {
                  "job_posting_id": { "type": "integer" },
                  "applicant_name": { "type": "string" },
                  "applicant_email": { "type": "string" },
                  "resume_url": { "type": "string" },
                  "cover_letter": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Application submitted" } }
      }
    },
    "/api/v1/job-postings/{id}/applications": {
      "get": {
        "summary": "Get Applications for Job Posting (Nested Route)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Applications for this job posting" } }
      },
      "post": {
        "summary": "Submit Application to Specific Job Posting (Nested Route)",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "201": { "description": "Application submitted directly to job" } }
      }
    }
  }
}
