# =====================================================================
# AlumniNexus - Environment Variables Configuration
# Copy this file to .env before starting the stack
# =====================================================================

# Application Configuration
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=alumni_nexus
DB_USER=alumni_admin
DB_PASS=alumni_secure_2026
DB_ROOT_PASSWORD=root_secure_2026

# Authentication & Token Configuration
AUTH_TOKEN_SECRET=alumni-istu-hs256-dev-secret-change-in-production-2026
AUTH_TOKEN_TTL_SECONDS=3600

# Anti-Bot CAPTCHA Configuration (works out-of-the-box locally with local_svg)
# Supported drivers: local_svg (default, no API keys needed), turnstile, recaptcha
CAPTCHA_DRIVER=local_svg
CAPTCHA_MODE=alphanumeric
CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_SECRET=alumni-istu-local-captcha-secret-2026
# Optional external provider keys (used only when CAPTCHA_DRIVER != local_svg)
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Google OAuth 2.0 ("Continue with Google" Registration & Sign-In)
# Create OAuth 2.0 Web Application credentials in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Owner Admin Account Seed Defaults (assigned role='admin' by database/seed.php & promote_admin.php)
ADMIN_USERNAME=kamasya
ADMIN_EMAIL=kamasyaatha.frari@ogr.iu.edu.tr
ADMIN_FULL_NAME="Kamasya Atha Frari"
ADMIN_PASSWORD=AdminPass2026!
